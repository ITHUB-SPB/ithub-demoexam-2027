generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        Int      @id @default(autoincrement())
  login     String   @unique 
  fullname  String
  password  String
  phone     String
  email     String
  entries   Entry[]
}

model Entry {
  id            Int      @id @default(autoincrement())
  course        String
  paymentType   String
  userId        Int      
  user          User     @relation(fields: [userId], references: [id]) 
  startAt       DateTime
  status        String?  @default("Новая")
  createdAt     DateTime @default(now())
}