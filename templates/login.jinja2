{% extends "./layout.jinja2" %}

{% block title %}Логин{% endblock %}

{% block content %}
<form action="/login" method="post">
    <input type="text" name="login" placeholder="Логин" pattern="[a-zA-Z0-9]{6,}" required>
    <p class="error">Корректно заполните поле (латиница и цифры, 6+ символов)</p>

    <input type="password" name="password" placeholder="Пароль" pattern="[^\s]{8,}" required>
    <p class="error">Корректно заполните поле (8+ символов)</p>

    <button class="button" type="submit">Войти</button>
</form>
<a href="/register" class="link">Еще не зарегистрированы? Регистрация</a>
{% endblock %}