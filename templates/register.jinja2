{% extends "layout.jinja2" %}

{% block title %}Регистрация{% endblock %}

{% block content %}
<form action="/register" method="post">
    <input type="text" name="login" placeholder="Логин" pattern="[a-zA-Z0-9]{6,}" required>
    <p class="alert-text">Корректно заполните поле (латиница и цифры, 6+ символов)</p>

    <input type="password" name="password" placeholder="Пароль" pattern="[^\s]{8,}" required>
    <p class="alert-text">Корректно заполните поле (8+ символов)</p>

    <input type="text" name="fio" placeholder="ФИО" pattern="[а-яА-Я ]+" required>
    <p class="alert-text">Корректно заполните поле (кириллица и пробелы)</p>

    <input type="text" name="phone" placeholder="Телефон" pattern="8\([0-9]{3}\)[0-9]{3}-[0-9]{2}-[0-9]{2}" required>
    <p class="alert-text">Корректно заполните поле (формат: 8(XXX)XXX-XX-XX)</p>

    <input type="email" name="email" placeholder="Email" required>
    <p class="alert-text">Корректно заполните поле (формат электронной почты)</p>

    <button class="action-btn" type="submit">Создать</button>
</form>
<a class="text-link" href="/login">Уже зарегистрированы?</a>
{% endblock %}
